# Identity of one MFS_1 device. The real files are secrets/<serial>.conf
# (gitignored, from tools/gen_fleet_credentials.py); this template documents
# their format.
#
# Build and flash with:
#     tools/flash_device.sh <serial> [--unlocked]
#
# The FIRMWARE BUILD reads only the serial and the device ID: flash_device.sh
# copies those two lines into a temporary conf for west build. The two keys
# below are provisioned into the nRF54L05 KMU by flash_device.sh and never
# reach a build - CMakeLists.txt fails any build that sets either one. A bare
# west build (no conf, or a conf with only these two identity lines) still
# builds, locked, but the device refuses commands until its KMU is provisioned.
# See docs/superpowers/specs/2026-11-15-kmu-keys-and-debug-lock-design.md.

CONFIG_ALC_DEVICE_SERIAL="MFS1-MMYY-00000"

# 32-bit device ID, 8 hex chars. Public; bound into every key derivation.
CONFIG_MFS_DEVICE_ID=""

# ---- TOOL-ONLY: read by tools/flash_device.sh (to provision the KMU) and by
# ---- tools/gen_bench_credentials.py (for class_app), NEVER by the build.
#
# Generate fresh keys with:
#     python3 -c "import secrets; print(secrets.token_hex(32).upper())"

# 32-byte per-device secret, 64 hex chars. Derives every day key.
CONFIG_MFS_DEVICE_SECRET=""

# 32-byte per-device provisioning key, 64 hex chars. Authorises a time sync
# while the clock is invalid, and nothing else. MUST differ from the secret -
# the firmware's boot key check refuses commands otherwise. See
# docs/tan-scheme.md 8.1.
CONFIG_MFS_PROVISION_KEY=""
