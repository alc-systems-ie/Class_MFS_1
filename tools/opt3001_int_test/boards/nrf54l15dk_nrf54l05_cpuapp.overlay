/*
 * CLASS MFS_1 hardware, first full revision — OPT3001 interrupt test. INT P1.12 -> FIRE_1 (P2.05), FIRE_2 (P2.09).
 *
 *   I2C 1 (i2c21) - nPM2100 at 0x74:            SCL P1.04, SDA P1.05
 *   I2C 2 (i2c22) - ADXL367 0x1D, OPT3001 0x44:  SCL P1.08, SDA P1.07
 *   OPT3001_INT P1.12, open-drain active low
 *
 * i2c21 stops the nPM2100 boot monitor and powers up LSOUT at 1.8 V, as the main
 * application does, in case the sensors are supplied from it.
 */

&pinctrl {
    i2c21_default: i2c21_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 1, 5)>,
                    <NRF_PSEL(TWIM_SCL, 1, 4)>;
            bias-pull-up;
        };
    };

    i2c21_sleep: i2c21_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 1, 5)>,
                    <NRF_PSEL(TWIM_SCL, 1, 4)>;
            low-power-enable;
        };
    };

    i2c22_default: i2c22_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 1, 7)>,
                    <NRF_PSEL(TWIM_SCL, 1, 8)>;
            bias-pull-up;
        };
    };

    i2c22_sleep: i2c22_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 1, 7)>,
                    <NRF_PSEL(TWIM_SCL, 1, 8)>;
            low-power-enable;
        };
    };
};

&i2c21 {
    status = "okay";
    pinctrl-0 = <&i2c21_default>;
    pinctrl-1 = <&i2c21_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <I2C_BITRATE_STANDARD>;
};

&i2c22 {
    status = "okay";
    pinctrl-0 = <&i2c22_default>;
    pinctrl-1 = <&i2c22_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <I2C_BITRATE_STANDARD>;
};

/* Not fitted / pins reused on this board. P2.05 (spi00 CS) is FIRE_1. */
&mx25r64 {
    status = "disabled";
};

&spi00 {
    status = "disabled";
};

&uart20 {
    status = "disabled";
};

/ {
    zephyr,user {
        /* OPT3001 INT is open-drain, active low (POL = 0). */
        opt-int-gpios = <&gpio1 12 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        /* ANTI_TAMP button arms (10 s delay) and disarms. Active low. */
        tamper-gpios = <&gpio1 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        /* LED3: flashes during the arming delay, steady while armed. */
        led3-gpios = <&gpio2 4 GPIO_ACTIVE_HIGH>;
        /* Bench unit: LEDs on the fire pins. External 10k pull-downs. */
        fire-gpios = <&gpio2 5 GPIO_ACTIVE_HIGH>,
                     <&gpio2 9 GPIO_ACTIVE_HIGH>;
    };
};

/* P1.02 (ANTI_TAMP) is an NFC pin: release it to GPIO. */
&uicr {
    nfct-pins-as-gpios;
};
