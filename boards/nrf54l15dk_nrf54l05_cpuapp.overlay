/*
 * Project CLASS MFS_1 pin map — CLASS MFS hardware, first full revision
 * (2026-11-10). nRF54L05 + nPM2100 + ADXL367 + OPT3001. No nRF21540 FEM.
 *
 * I²C 1 (i2c21) - nPM2100:      SCL P1.04, SDA P1.05, addr 0x74.
 * I²C 2 (i2c22) - ADXL367:      SCL P1.08, SDA P1.07, addr 0x1D.
 *                 OPT3001:      same bus (not used by v1 firmware).
 * LEDs (replace DK's):          LED A = LED3 P2.04 (led0), LED B = LED2 P2.03 (led1).
 *                               LED1 P2.02 is fitted but unused by the app.
 * Fire outputs:                 FIRE_1 P2.05, FIRE_2 P2.09 (see zephyr,user).
 * ADXL367 INT1:                 P1.03 — wakes the SoC.
 * ADXL367 INT2:                 P1.13 — routed to the SoC, NOT to the nPM2100
 *                               SHPHLD pin as on alc_drawer_master. Unused.
 * OPT3001 INT:                  P1.12 (unused).
 * ANTI_TAMP button:             P1.02, pulled high, active low (unused by v1).
 * nPM2100 host signals:         GPIO0 P1.06, RESET P2.00 (unused by firmware).
 *
 * !!! OPEN: the board pin list gives P2.02 as both LED1 and nPM2100 GPIO_1.
 * !!! The firmware leaves P2.02 undriven until that is confirmed.
 *
 * GPIO active levels for PMIC_RESET and the interrupt inputs are inherited
 * assumptions from alc_drawer_master; confirm against the PMIC / ADXL pin
 * configuration once driven.
 */

&pinctrl {
    /* ─── i2c21 → nPM2100 ─── */
    i2c21_default: i2c21_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 1, 5)>,
                    <NRF_PSEL(TWIM_SCL, 1, 4)>;
            bias-pull-up;
        };
    };

    i2c21_sleep: i2c21_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 1, 5)>,
                    <NRF_PSEL(TWIM_SCL, 1, 4)>;
            low-power-enable;
        };
    };

    /* ─── i2c22 → ADXL367 + OPT3001 ─── */
    i2c22_default: i2c22_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 1, 7)>,
                    <NRF_PSEL(TWIM_SCL, 1, 8)>;
            bias-pull-up;
        };
    };

    i2c22_sleep: i2c22_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 1, 7)>,
                    <NRF_PSEL(TWIM_SCL, 1, 8)>;
            low-power-enable;
        };
    };
};

&i2c22 {
    status = "okay";
    pinctrl-0 = <&i2c22_default>;
    pinctrl-1 = <&i2c22_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <I2C_BITRATE_STANDARD>;
};

/* The DK console UART20 sits on P1.04 / P1.05 — the nPM2100 I2C bus here. */
&uart20 {
    status = "disabled";
};

&i2c21 {
    status = "okay";
    pinctrl-0 = <&i2c21_default>;
    pinctrl-1 = <&i2c21_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <I2C_BITRATE_STANDARD>;
};

/* The DK board files fit an onboard Macronix MX25R64 external flash on spi00 and
 * enable it by default. The bespoke board has no such part, so enabling
 * CONFIG_FLASH for NVS made the spi_nor driver probe a device that is not there
 * and log on every boot:
 *
 *   <err> spi_nor: Device id 00 00 00 does not match config c2 28 17
 *
 * Harmless, but a permanent spurious error trains you to ignore real ones. NVS
 * lives in the nRF54L05's internal RRAM, not here. Disable the flash node and the
 * bus it sits on — spi00 is not used by this design either.
 */
&mx25r64 {
    status = "disabled";
};

&spi00 {
    status = "disabled";
};

/ {
    /* Application-side control GPIOs that don't belong to a standard driver
     * binding. Access from C++ via e.g.:
     *   GPIO_DT_SPEC_GET(DT_PATH(zephyr_user), adxl_int1_gpios)
     */
    zephyr_user: zephyr,user {
        pmic-gpio0-gpios = <&gpio1 6 GPIO_ACTIVE_HIGH>;
        pmic-reset-gpios = <&gpio2 0 GPIO_ACTIVE_LOW>;
        adxl-int1-gpios  = <&gpio1 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;

        /* ─── FIRE OUTPUT — THE DEVICE'S ACTUAL OUTPUT ───
         *
         * Fire1 and Fire2 form ONE logical channel. They are not a set/reset
         * pair and must never be driven independently. On assert, FIRE_1 goes
         * first and FIRE_2 follows 10 ms later (the firing order this hardware
         * revision requires); they always clear together. In the product
         * this output switches a voltage, so only alc::OutputSwitch may touch
         * these pins — it owns them privately and exposes Enable(), Set() and
         * Disable() alone. Nothing else may take a handle to them.
         *
         * ACTIVE_HIGH because both lines carry external 10k pull-downs. That
         * makes the hardware fail-safe through reset: the nRF54L brings GPIOs up
         * high-Z, so the pull-downs hold the output de-energised. Firmware keeps
         * it that way: the pins have NO driver (GPIO_DISCONNECTED) whenever the
         * device is not armed. Boot only reads each pin as a plain input (it
         * must read low) and disconnects it; the pins become outputs —
         * GPIO_OUTPUT_INACTIVE only, never GPIO_OUTPUT_ACTIVE — as the last step
         * of arming, and every disarm drives them low and disconnects them
         * again. See docs/superpowers/specs/2026-09-14-arming-sequence-amendment.md.
         *
         * !!! BOTH PINS ARE CLAIMED BY THE DK BOARD FILES AND ARE ONLY FREE HERE
         * !!! BECAUSE OF TWO OVERRIDES MADE FOR UNRELATED REASONS:
         *
         *   P2.05 is spi00's cs-gpios (external-flash chip select). It is free
         *         only because &spi00 is disabled below — a change made to
         *         silence a spurious spi_nor probe error, not for this.
         *         RE-ENABLING spi00 WOULD HAND FIRE1 TO THE SPI DRIVER AS A CHIP
         *         SELECT AND TOGGLE IT ON EVERY TRANSACTION.
         *
         *   P2.09 is the DK's led0 ("Green LED 0"). It is free only because
         *         &led0 is remapped to P2.04 below to match the bespoke board.
         *
         * Do not re-enable spi00 or remove the led0 override without moving
         * these pins first.
         */
        fire1-gpios = <&gpio2 5 GPIO_ACTIVE_HIGH>;
        fire2-gpios = <&gpio2 9 GPIO_ACTIVE_HIGH>;
    };
};

/* Release P1.02 / P1.03 from the NFC peripheral so they can be used as
 * GPIOs (ANTI_TAMP and ADXL INT1 on this board). Without this UICR property, the NFCT block
 * owns those pads and any GPIO writes have no effect on the physical pin.
 * Setting this property bakes the bit into the UICR hex at build time. */
&uicr {
    nfct-pins-as-gpios;
};

/* Override DK's LED pins to match the bespoke board.
 * The DK's nRF54L05 variant only defines led0 and led1 (no led2/led3).
 * led0 = LED A (Inactive indicator), led1 = LED B (Active + triggered). */
&led0 {
    gpios = <&gpio2 4 GPIO_ACTIVE_HIGH>;
};

&led1 {
    gpios = <&gpio2 3 GPIO_ACTIVE_HIGH>;
};

/* HFXO trim, inherited from alc_drawer_master. CL = 8 pF (Kyocera CX2016DB,
 * f_tol +/- 15 ppm, f_tem +/- 20 ppm).
 *
 * Trimmed 2026-05-28 on that board, residual +1.27 ppm at 2440 MHz, 25 degC
 * (CONFIG_HFXO_TRIM=y). Layout sensitivity ~9.3 ppm/pF;
 * load-capacitance-femtofarad must be a multiple of 250 fF per the
 * nordic,nrf54l-hfxo binding enum.
 *
 * NOTE: that trim was measured with the FEM in TX state. MFS_1 has no FEM, so
 * re-verify the residual on this build before relying on it.
 */
&hfxo {
    load-capacitance-femtofarad = <14000>;
};

/*
 * LFXO — 32.768 kHz crystal, confirmed fitted on the bespoke board.
 *
 * This is the timebase for TAN day indexing, so its accuracy is a security
 * parameter, not just a convenience (docs/tan-scheme.md section 8.4). No Kconfig
 * is needed to select it: CONFIG_CLOCK_CONTROL_NRF_K32SRC_XTAL and
 * CONFIG_NRF_GRTC_TIMER_SOURCE_LFXO are already the defaults for this target.
 *
 * Crystal: Abracon ABS06N-32.768kHz-9-T. The "-9-" field is the specified load
 * capacitance, CL = 9 pF, hence 9000 fF below.
 *
 * The property is the crystal's load capacitance, not a raw register value. Per
 * the nRF54L15 PS, quoted in zephyr/soc/nordic/nrf54l/soc.c:
 *   CAPVALUE = round((2*CAPACITANCE - 12) * (SLOPE + 0.765625*2^9)/2^9 + OFFSET/2^6)
 *   where CAPACITANCE is the desired capacitor value in pF, 4-18 pF in 0.5 pF steps.
 * The "-12" is the device subtracting its own pin/package contribution, and the
 * FICR XOSC32KTRIM slope/offset apply the per-die factory trim.
 *
 * The value is stated EXPLICITLY rather than inherited, because silently
 * inheriting the DK's 17000 fF is precisely how this went unexamined in
 * alc_drawer_master. That value corresponds to a 17 pF crystal; against this
 * board's 9 pF part it over-capacitates by 8 pF, which pulls the oscillator
 * roughly 45-50 ppm SLOW (estimate assumes ABS06N-typical C0 ~1.2 pF,
 * C1 ~2.2 fF) — about 25 minutes lost per year, on top of the crystal's own
 * tolerance.
 *
 * !!! STILL TO TRIM BY MEASUREMENT. 9000 fF is the nominal value from the part
 * number, not a measured one. Board stray capacitance shifts the optimum: note
 * that &hfxo above sits at 14000 fF against a nominally 8 pF crystal after
 * trimming on this same board. Measure and record the residual here, as was done
 * for &hfxo.
 *
 * A mispulled LFXO will not show up as a fault: Bluetooth LE tolerates up to
 * 500 ppm of sleep-clock error, so links work normally at 100 ppm and nothing
 * complains. Only accumulated drift reveals it. See docs/power-budget.md 8.5.2.
 */
&lfxo {
    load-capacitors = "internal";
    load-capacitance-femtofarad = <9000>;
};
